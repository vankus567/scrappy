# ---- apps/api (Scrappy Human API) ----
PAY_TO=                       # platform Solana address receiving agent payments
SOLANA_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1   # devnet; mainnet: solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
X402_FACILITATOR_URL=https://x402.org/facilitator
ADMIN_TOKEN=                  # for POST /v1/admin/gold (scripts/seed-gold.ts)
WEB_ORIGINS=http://localhost:3000
SCRAPPY_DB=scrappy.db
VAPID_PUBLIC_KEY=             # web push: bunx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
# settlement (auto-settles in the API when PLATFORM_KEY_FILE exists; manual: scripts/payout.ts)
PLATFORM_KEY_FILE=               # default: apps/api/.keys/platform.json
SETTLE_INTERVAL_MS=600000        # SETTLE=off disables the in-process settlement worker
SOLANA_RPC=https://api.devnet.solana.com
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU   # mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
MIN_PAYOUT_USDC=0.1
# ---- apps/web ----
NEXT_PUBLIC_SCRAPPY_API=http://localhost:8787
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_APK_URL=          # set once the signed APK is published (shows the download link)
# ---- apps/mcp + demo agents ----
SCRAPPY_API=http://localhost:8787
SCRAPPY_API_KEY=                 # project key from the dashboard, or:
SCRAPPY_AGENT_SECRET=            # base58 64-byte agent wallet key, pays per task over x402 (never commit)
ANTHROPIC_API_KEY=            # for scripts/deploy-guard.ts (the agent's own review)
