{
  "name": "@scrappy/console",
  "version": "0.1.0",
  "description": "A tiny retro game console for the browser: 16 colors, 4 sound channels, cartridges. API modeled on kitao/pyxel (MIT).",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "dev": "bun --hot dev/server.ts",
    "build": "bun build dev/index.html --outdir dist --minify"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
